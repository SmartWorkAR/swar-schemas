{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartworkar.github.io/swar-schemas/schemas/v2.0.0/process.schema.json",
  "version": "2.0.0",
  "type": "object",
  "title": "SWAR Process Definition v2 (Corrected)",
  "description": "SWAR Version 2.0 process definition aligned with sequential testing mock",
  "required": [
    "reference",
    "executionRefName",
    "description",
    "fullDescription",
    "version",
    "definition"
  ],
  "properties": {
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "fullDescription": {
      "type": "string",
      "minLength": 1
    },
    "executionRefName": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string"
    },
    "definition": {
      "type": "object",
      "required": [
        "processRef",
        "name",
        "description",
        "dataModel",
        "activities"
      ],
      "properties": {
        "processRef": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "dataModel": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/DataType"
              }
            }
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Activity"
          }
        },
        "documents": {
          "type": "array",
          "default": [ ]
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DataType": {
      "oneOf": [
        {
          "title": "String Type",
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "nullable": {
              "type": "boolean"
            },
            "check": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "title": "Number Type",
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "number",
                "int"
              ]
            },
            "digits": {
              "type": "integer",
              "minimum": 0
            },
            "decimals": {
              "type": "integer",
              "minimum": 0
            },
            "nullable": {
              "type": "boolean"
            },
            "check": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "title": "Boolean Type",
          "type": "object",
          "properties": {
            "type": {
              "const": "boolean"
            },
            "nullable": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TaskAction": {
      "oneOf": [
        {
          "title": "Form Action",
          "type": "object",
          "properties": {
            "type": {
              "const": "form"
            },
            "definition": {
              "type": "object",
              "required": [
                "id",
                "description",
                "fields"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "required": [
            "type",
            "definition"
          ]
        },
        {
          "title": "Instruction Action",
          "type": "object",
          "properties": {
            "type": {
              "const": "instruction"
            },
            "instructions": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "instructions"
          ]
        },
        {
          "title": "Choice Action",
          "type": "object",
          "properties": {
            "type": {
              "const": "choice"
            },
            "prompt": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "label"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "type",
            "prompt",
            "options"
          ]
        }
      ]
    },
    "Activity": {
      "oneOf": [
        {
          "title": "Task Activity",
          "type": "object",
          "properties": {
            "type": {
              "const": "task"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "action": {
              "$ref": "#/definitions/TaskAction"
            },
            "output": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [ ]
            }
          },
          "required": [
            "type",
            "id",
            "action"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}