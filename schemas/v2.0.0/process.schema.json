{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartworkar.github.io/swar-schemas/schemas/v2.0.0/process.schema.json",
  "version": "2.0.0",
  "type": "object",
  "title": "SWAR Process Definition v2",
  "description": "SWAR process definition aligned with the current modules/swar-domain Kotlin serialization model",
  "required": [
    "reference",
    "description",
    "fullDescription",
    "version",
    "definition"
  ],
  "properties": {
    "reference": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fullDescription": {
      "type": "string"
    },
    "executionRefName": {
      "type": "string",
      "default": "UUID",
      "description": "Name of the process execution reference. Defaults to UUID."
    },
    "executionRefMask": {
      "type": "string"
    },
    "version": {
      "$ref": "#/definitions/SemVer"
    },
    "definition": {
      "$ref": "#/definitions/ProcessDef"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SemVer": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+){0,2}$"
    },
    "ProcessDef": {
      "type": "object",
      "required": [
        "processRef",
        "dataModel",
        "activities"
      ],
      "properties": {
        "processRef": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "externalIdName": {
          "type": [
            "string",
            "null"
          ],
          "default": "uuid"
        },
        "dataModel": {
          "$ref": "#/definitions/ObjectType"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Activity"
          }
        }
      },
      "additionalProperties": false
    },
    "DataType": {
      "oneOf": [
        {
          "$ref": "#/definitions/StringType"
        },
        {
          "$ref": "#/definitions/NumberType"
        },
        {
          "$ref": "#/definitions/BooleanType"
        },
        {
          "$ref": "#/definitions/DateTimeType"
        },
        {
          "$ref": "#/definitions/AnyType"
        },
        {
          "$ref": "#/definitions/EnumType"
        },
        {
          "$ref": "#/definitions/ArrayType"
        },
        {
          "$ref": "#/definitions/MediaDataType"
        },
        {
          "$ref": "#/definitions/ObjectDataType"
        }
      ]
    },
    "StringType": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "string"
        },
        "nullable": {
          "type": "boolean",
          "default": false
        },
        "mask": {
          "type": [
            "string",
            "null"
          ]
        },
        "check": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "NumberType": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "number"
        },
        "digits": {
          "type": "integer"
        },
        "decimals": {
          "type": "integer",
          "default": 0
        },
        "nullable": {
          "type": "boolean",
          "default": false
        },
        "check": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "BooleanType": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "boolean"
        },
        "nullable": {
          "type": "boolean",
          "default": false
        },
        "check": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "DateTimeType": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "datetime"
        },
        "nullable": {
          "type": "boolean",
          "default": false
        },
        "check": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "AnyType": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "any"
        },
        "nullable": {
          "type": "boolean",
          "default": false
        },
        "check": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "EnumType": {
      "type": "object",
      "required": [
        "type",
        "values"
      ],
      "properties": {
        "type": {
          "const": "enum"
        },
        "values": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ],
          "description": "Static values or an expression that resolves the allowed values at runtime."
        },
        "nullable": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "ArrayType": {
      "type": "object",
      "required": [
        "type",
        "elementType"
      ],
      "properties": {
        "type": {
          "const": "array"
        },
        "elementType": {
          "$ref": "#/definitions/DataType"
        },
        "nullable": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "MediaDataType": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "media"
        },
        "nullable": {
          "type": "boolean",
          "default": true
        },
        "check": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ObjectType": {
      "type": "object",
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/DataType"
          }
        },
        "nullable": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "ObjectDataType": {
      "type": "object",
      "required": [
        "type",
        "fields"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/DataType"
          }
        },
        "nullable": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Mapping": {
      "type": "string"
    },
    "Activity": {
      "oneOf": [
        {
          "$ref": "#/definitions/TaskActivity"
        },
        {
          "$ref": "#/definitions/SequenceActivity"
        },
        {
          "$ref": "#/definitions/DecisionActivity"
        },
        {
          "$ref": "#/definitions/GroupActivity"
        },
        {
          "$ref": "#/definitions/ScriptActivity"
        },
        {
          "$ref": "#/definitions/HttpActivity"
        }
      ]
    },
    "TaskActivity": {
      "type": "object",
      "required": [
        "type",
        "id",
        "name",
        "action"
      ],
      "properties": {
        "type": {
          "const": "task"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "action": {
          "$ref": "#/definitions/TaskAction"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Mapping"
          },
          "default": []
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Mapping"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "SequenceActivity": {
      "type": "object",
      "required": [
        "type",
        "id",
        "name",
        "activities"
      ],
      "properties": {
        "type": {
          "const": "sequence"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Activity"
          }
        }
      },
      "additionalProperties": false
    },
    "DecisionActivity": {
      "type": "object",
      "required": [
        "type",
        "id",
        "expression",
        "branches"
      ],
      "properties": {
        "type": {
          "const": "decision"
        },
        "id": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "branches": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Activity"
          }
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "GroupActivity": {
      "type": "object",
      "required": [
        "type",
        "id",
        "name",
        "activities"
      ],
      "properties": {
        "type": {
          "const": "group"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Activity"
          }
        }
      },
      "additionalProperties": false
    },
    "ScriptActivity": {
      "type": "object",
      "required": [
        "type",
        "id",
        "name",
        "script",
        "outputKey"
      ],
      "properties": {
        "type": {
          "const": "script"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "script": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "HttpActivity": {
      "type": "object",
      "required": [
        "type",
        "id",
        "name",
        "urlExpression",
        "method",
        "bodyExpression",
        "outputKey"
      ],
      "properties": {
        "type": {
          "const": "http"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "urlExpression": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "bodyExpression": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TaskAction": {
      "oneOf": [
        {
          "$ref": "#/definitions/FormAction"
        },
        {
          "$ref": "#/definitions/InstructionAction"
        },
        {
          "$ref": "#/definitions/ChoiceAction"
        }
      ]
    },
    "FormAction": {
      "type": "object",
      "required": [
        "type",
        "definition"
      ],
      "properties": {
        "type": {
          "const": "form"
        },
        "definition": {
          "$ref": "form-definition.schema.json"
        }
      },
      "additionalProperties": false
    },
    "InstructionAction": {
      "type": "object",
      "required": [
        "type",
        "instructions"
      ],
      "properties": {
        "type": {
          "const": "instruction"
        },
        "instructions": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ChoiceAction": {
      "type": "object",
      "required": [
        "type",
        "prompt",
        "options"
      ],
      "properties": {
        "type": {
          "const": "choice"
        },
        "prompt": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChoiceOption"
          }
        }
      },
      "additionalProperties": false
    },
    "ChoiceOption": {
      "type": "object",
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
