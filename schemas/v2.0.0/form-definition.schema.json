{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Form Definition",
  "description": "Serializable definition of a SWAR form, matching FormSerializer.",
  "type": "object",
  "required": ["id", "description", "fields"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique form identifier."
    },
    "description": {
      "type": "string",
      "description": "Human-readable form description."
    },
    "showTitle": {
      "type": "boolean",
      "default": false,
      "description": "When true, render the description as the form title."
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/formElement"
      },
      "description": "Ordered top-level scalar fields, rows, and array fields."
    }
  },
  "additionalProperties": false,
  "definitions": {
    "formElement": {
      "description": "A top-level element: a row, scalar field, or array field.",
      "oneOf": [
        {
          "$ref": "#/definitions/formRow"
        },
        {
          "$ref": "#/definitions/topLevelFieldWrapper"
        }
      ]
    },
    "formRow": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/scalarFieldWrapper"
      },
      "description": "Horizontal grouping of scalar fields. Rows are encoded directly as JSON arrays."
    },
    "topLevelFieldWrapper": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/scalarField"
          },
          {
            "$ref": "#/definitions/arrayField"
          }
        ]
      },
      "description": "Single-key object whose key is the field name."
    },
    "scalarFieldWrapper": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/scalarField"
      },
      "description": "Single-key scalar field object. Used in rows and array templates."
    },
    "enumValues": {
      "description": "Static options or an expression that resolves to options at runtime.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "scalarField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "text",
            "mask",
            "multiline",
            "number",
            "checkbox",
            "toggle",
            "date",
            "datetime",
            "select",
            "radio",
            "display",
            "media"
          ],
          "default": "text",
          "description": "Field kind. When omitted, FormSerializer deserializes the field as text."
        },
        "label": {
          "type": "string",
          "description": "Explicit display label. When omitted, the label is inferred from the field name."
        },
        "errorMessage": {
          "type": "string",
          "description": "Message displayed when validation fails."
        },
        "hidden": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string" }
          ],
          "description": "Visibility expression. A literal boolean is the common always-hidden/always-visible case; a string is evaluated as an expression against the same scope as check, re-evaluated whenever sibling field values change. Omitted means always visible. A hidden field takes no layout space and is exempt from validation while hidden."
        },
        "width": {
          "type": "integer",
          "description": "Responsive-grid weight. Defaults to 12, except radio fields, which default to 1."
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "Inverse of DataType.nullable. The serializer omits it when true."
        },
        "check": {
          "type": "string",
          "description": "Validation expression evaluated with the field value bound as value."
        },
        "maxLength": {
          "type": "integer",
          "description": "Text-field UI hint; validation must be expressed with check."
        },
        "mask": {
          "type": "string",
          "description": "Input mask used by a mask field."
        },
        "maskMessage": {
          "type": "string",
          "description": "Hint describing the expected masked input."
        },
        "digits": {
          "type": "integer",
          "description": "Total numeric precision."
        },
        "decimals": {
          "type": "integer",
          "description": "Numeric scale. Defaults to 0."
        },
        "values": {
          "$ref": "#/definitions/enumValues"
        },
        "horizontal": {
          "type": "boolean",
          "default": false,
          "description": "Lay out radio options horizontally."
        },
        "expression": {
          "type": "string",
          "description": "Expression evaluated and rendered by a display field."
        },
        "style": {
          "enum": ["header", "title", "body", "label"],
          "default": "body",
          "description": "Display-field typography style."
        },
        "align": {
          "enum": ["left", "center", "right"],
          "default": "left",
          "description": "Display-field horizontal alignment."
        },
        "mediaType": {
          "enum": ["photo", "video", "audio"],
          "description": "Kind of media to capture."
        },
        "maxDuration": {
          "type": "integer",
          "description": "Maximum recording duration in whole seconds. Ignored for photos."
        },
        "quality": {
          "enum": ["low", "default", "high"],
          "default": "default",
          "description": "Best-effort platform capture quality."
        },
        "useFrontCamera": {
          "type": "boolean",
          "default": false,
          "description": "Use the front camera for photo or video capture."
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "text"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "check", "maxLength"]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": {
              "const": "mask"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "check", "mask", "maskMessage"]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": {
              "const": "multiline"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "check"]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": {
              "const": "number"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "check", "digits", "decimals"]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": {
              "const": "checkbox"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "check"]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": {
              "const": "toggle"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "check"]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": {
              "const": "date"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "check"]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": {
              "const": "datetime"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "check"]
          }
        },
        {
          "required": ["type", "values"],
          "properties": {
            "type": {
              "const": "select"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "values"]
          }
        },
        {
          "required": ["type", "values"],
          "properties": {
            "type": {
              "const": "radio"
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "errorMessage", "hidden", "width", "required", "values", "horizontal"]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": {
              "const": "display"
            },
            "required": {
              "const": false
            }
          },
          "propertyNames": {
            "enum": ["type", "label", "hidden", "width", "required", "expression", "style", "align"]
          }
        },
        {
          "required": ["type", "mediaType"],
          "properties": {
            "type": {
              "const": "media"
            }
          },
          "propertyNames": {
            "enum": [
              "type",
              "label",
              "errorMessage", "hidden",
              "width",
              "required",
              "check",
              "mediaType",
              "maxDuration",
              "quality",
              "useFrontCamera"
            ]
          }
        }
      ]
    },
    "arrayField": {
      "type": "object",
      "required": ["type", "fields"],
      "properties": {
        "type": {
          "const": "array"
        },
        "fixed": {
          "type": "boolean",
          "default": false,
          "description": "When true, the row count is set once from the data the form is initialized with and cannot be changed by the user — no add/remove controls are rendered."
        },
        "label": {
          "type": "string",
          "description": "Explicit display label for the array's section header. When omitted, the label is inferred from the field name."
        },
        "fields": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/formRow"
              },
              {
                "$ref": "#/definitions/scalarFieldWrapper"
              }
            ]
          },
          "description": "Repeatable template containing scalar fields or rows. Nested arrays are not supported."
        }
      },
      "additionalProperties": false
    }
  }
}
